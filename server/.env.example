DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
SEED_ADMIN_EMAIL=staff@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Demo Staff

# ABDM sandbox. Client id is the portal username. Client secret is the portal password.
# Put the secret in server/.env only. Do not commit it.
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_HFR_BASE_URL=
ABDM_HPR_BASE_URL=
ABDM_SANDBOX_HOST_ALLOWLIST=dev.abdm.gov.in,abhasbx.abdm.gov.in
ABDM_CLIENT_ID=SBXID_098613
ABDM_CLIENT_SECRET=
ABDM_CM_ID=sbx
# Benefit or program name approved by NHA. Required before Aadhaar enrolment.
ABDM_BENEFIT_NAME=
# Local 32-byte keys, base64. Generate them yourself. The sandbox does not issue these.
ABHA_ENC_KEY=
ABHA_HASH_KEY=
ABHA_ENC_KEY_VERSION=1
