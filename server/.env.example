DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
SEED_ADMIN_EMAIL=staff@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_ROLE=CLINICIAN
SEED_ADMIN_NAME=Demo Staff

# ABDM sandbox. Client id is the portal username. Client secret is the portal password.
# Put the secret in server/.env only. Do not commit it.
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in
# M4 registries (HFR facility, HPR professional). Both live on the same sandbox host, under /v4/int.
ABDM_HFR_BASE_URL=https://apihspsbx.abdm.gov.in/v4/int
ABDM_HPR_BASE_URL=https://apihspsbx.abdm.gov.in/v4/int
ABDM_SANDBOX_HOST_ALLOWLIST=dev.abdm.gov.in,abhasbx.abdm.gov.in,apihspsbx.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CM_ID=sbx
# Benefit or program name approved by NHA. Required before Aadhaar enrolment.
ABDM_BENEFIT_NAME=
# Local 32-byte keys, base64. Generate them yourself. The sandbox does not issue these.
ABHA_ENC_KEY=
ABHA_HASH_KEY=
ABHA_ENC_KEY_VERSION=1

# M2 HIP. ABDM_HIP_ID is the bridge-services entry whose types include HIP.
ABDM_HIP_ID=
# Public HTTPS base registered with PATCH /api/hiecm/gateway/v3/bridge/url (for example an ngrok URL).
ABDM_CALLBACK_BASE_URL=
# ABDM request/response tracing for /abha-traffic. Defaults on in development.
ABDM_TRACE=

# M3 HIU. ABDM_HIU_ID is the bridge-services entry whose types include HIU.
# Empty means every HIU gateway call is refused locally (HIU_ID_MISSING).
ABDM_HIU_ID=
# Requester name shown in the patient's PHR app. Defaults to the facility name.
ABDM_HIU_NAME=
# Public HTTPS base for the data push URL. Defaults to ABDM_CALLBACK_BASE_URL.
ABDM_HIU_DATA_PUSH_BASE_URL=
ABDM_HIU_KEY_TTL_MINUTES=60
ABDM_HIU_PUSH_BODY_LIMIT=10mb
# Consent expiry poll and dataEraseAt purge. Defaults on outside tests.
HIU_SWEEPER_ENABLED=

# M4 bridge link. The bridge id from your sandbox registration. Empty means the link call is refused locally.
ABDM_BRIDGE_ID=
